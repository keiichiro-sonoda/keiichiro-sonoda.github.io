---
// 記事のページ。URL は Jekyll と同じ /YYYY/MM/DD/<名前>.html（build.format: "preserve" で .html が付く）
import { render } from "astro:content";
import Post from "../layouts/Post.astro";
import { listPosts, postSlug, type Post as PostEntry } from "../lib/posts";

export async function getStaticPaths() {
  const posts = await listPosts();
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props as { post: PostEntry };
const { Content } = await render(post);
---

<Post title={post.data.title} date={post.data.date} description={post.data.description}>
  <Content />
</Post>
